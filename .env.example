# Copy to .env.local (never commit the filled-in copy) or paste the same names into the host's
# environment variables. Everything here is server-only: no page ever reads these.

# --- Svix: outbound webhooks, signed to the Standard Webhooks spec ----------------------------
# API key from https://dashboard.svix.com -> API Access. Empty means webhooks stay off; the site and
# the shop keep working.
SVIX_API_KEY=
# Optional. An existing Svix application id to send to. Left empty, the first event uses (and if
# needed creates) the `jaysteeljewelry` application.
SVIX_APP_ID=
# Optional. Regional Svix API base, e.g. https://api.eu.svix.com for an EU account.
SVIX_SERVER_URL=
