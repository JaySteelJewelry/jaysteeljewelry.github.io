{
  "name": "jaysteeljewelry",
  "private": true,
  "description": "JAY STEEL JEWELRY site: static pages at the repo root, plus a Node API for the shop and Svix-signed outbound webhooks.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/dev.mjs",
    "dev": "node server/dev.mjs",
    "test": "node --test test/*.test.mjs",
    "check:events": "node scripts/validate-events.mjs",
    "check:freshness": "node scripts/freshness.mjs",
    "check:assets": "node scripts/asset-versions.mjs --check",
    "version:assets": "node scripts/asset-versions.mjs",
    "check:sitemap": "node scripts/sitemap.mjs --check",
    "sitemap": "node scripts/sitemap.mjs",
    "sync:events": "node scripts/sync-events.mjs",
    "season:ics": "node scripts/season-ics.mjs",
    "seed": "node db/seed.mjs",
    "seed:print": "node db/seed.mjs --print"
  },
  "dependencies": {
    "svix": "2.11.1"
  }
}
